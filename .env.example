# ==============================================================================
# AI Judiciary Configuration
# ==============================================================================
# Provider selection: 'nvidia', 'gemini', or 'claude'
LLM_PROVIDER=nvidia

# ------------------------------------------------------------------------------
# LLM Timeout & Retry Configuration (Applies to all providers)
# ------------------------------------------------------------------------------
# Connection timeout in seconds (TCP connect + TLS handshake)
LLM_CONNECT_TIMEOUT=15.0
# Read timeout in seconds (waiting for response generation)
LLM_READ_TIMEOUT=90.0
# Maximum retry attempts for transient errors (SSL, timeout, rate limit)
LLM_MAX_RETRIES=3
# Base backoff seconds for rate limit (HTTP 429) retries
LLM_RATE_LIMIT_BACKOFF=10.0
# Maximum concurrent API calls for parallel execution (default: 2)
LLM_MAX_CONCURRENCY=2

# ------------------------------------------------------------------------------
# Vision Configuration (Used for image-based debates)
# ------------------------------------------------------------------------------
# Vision model to use (NVIDIA NIM)
# NVIDIA NIM Vision Model: nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Maximum vision output tokens (global default)
NVIDIA_VISION_MAX_TOKENS=4096
# Per-agent vision token budgets (can override global default)
VISION_ADVOCATE_MAX_TOKENS=2048
VISION_OPPOSER_MAX_TOKENS=2048
VISION_REBUTTAL_MAX_TOKENS=2048
VISION_JUDGE_MAX_TOKENS=4096
# Maximum image upload size in MB
MAX_IMAGE_SIZE_MB=20
# Allowed image MIME types (comma-separated)
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp

# ------------------------------------------------------------------------------
# NVIDIA NIM Settings (Used when LLM_PROVIDER=nvidia)
# Get your API key from NVIDIA Build: https://build.nvidia.com/
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-your-key
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ------------------------------------------------------------------------------
# Google Gemini Settings (Used when LLM_PROVIDER=gemini)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# Anthropic Claude Settings (Used when LLM_PROVIDER=claude)
# Get your API key from Anthropic Console: https://console.anthropic.com/
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
